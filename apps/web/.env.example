# Public origins
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
CASINO_API_ORIGIN=http://localhost:3000

# Discord OAuth application (server-side only except the public client ID)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# Optional private-access gates. Use one guild ID and/or comma-separated user IDs.
DISCORD_ALLOWED_GUILD_ID=
DISCORD_USER_ALLOWLIST=

# Discord companion bot
DISCORD_BOT_TOKEN=
DISCORD_BOT_API_SECRET=replace-with-an-independent-48-byte-secret
# Set during development for immediate guild-scoped command registration.
DISCORD_COMMAND_GUILD_ID=

# Sessions and play-money economy
SESSION_SECRET=replace-with-an-independent-48-byte-secret
STARTING_BALANCE=10000
DAILY_REFILL_AMOUNT=500

# Enabled automatically on localhost. Set true only for an isolated private test deployment, then disable it before sharing.
DEV_AUTH_BYPASS=false
